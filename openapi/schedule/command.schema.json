{
  "title": "schedule.Command",
  "description": "自包含、可持久化的执行或通知意图。接入方按 id 幂等投递。\n STATE 通知节点或根控制模式变化后的当前状态；END 只在首次全部收尾时产生。",
  "type": "object",
  "properties": {
    "definitionHash": {
      "type": "string"
    },
    "id": {
      "description": "TASK 命令 id 同时作为逻辑执行标识，由实例 ID 和节点 ID 确定。",
      "type": "string"
    },
    "instanceId": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/components/schemas/schedule.CommandKind"
    },
    "mode": {
      "$ref": "#/components/schemas/schedule.Mode"
    },
    "revision": {
      "type": "string",
      "format": "uint64"
    },
    "state": {
      "$ref": "#/components/schemas/schedule.NodeState"
    },
    "task": {
      "$ref": "#/components/schemas/schedule.Node"
    }
  }
}
