  "properties": {
    "errorMessage": {
      "type": "string"
    },
    "executionId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "instanceId": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/components/schemas/schedule.EventKind"
    },
    "nodeId": {
      "type": "string"
    },
    "resultRef": {
      "type": "string"
    }
  }
}
